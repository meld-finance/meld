# Serves the Meld web app and forwards /api/* to the API container.
# Plain HTTP: docker-compose.yml publishes this on 127.0.0.1 only. See README
# ("Reaching Meld from other devices") before exposing it anywhere else.
{
	admin off
	auto_https off
}

:8080 {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:4000 {
			# Stream chat answers as they arrive.
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# Bundles have content hashes in their names, so they never change; everything else
		# (index.html above all) is revalidated, so a rebuild shows up on the next load.
		@hashed path /_expo/static/*
		@unhashed not path /_expo/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @unhashed Cache-Control "no-cache"
		# Single-page app: unknown paths load index.html and the router takes over.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
}
