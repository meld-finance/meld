# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://meld:meld@127.0.0.1:5432/meld
# Separate database for integration tests (wiped on each run). Create it with:
#   docker compose exec db createdb -U meld meld_test
TEST_DATABASE_URL=postgres://meld:meld@127.0.0.1:5432/meld_test
API_PORT=4000
# Comma-separated origins allowed to call the API (Expo web dev server).
CORS_ORIGINS=http://localhost:8081

# Single-user auth: the passphrase you log in with, and a secret for signing sessions.
# Generate secrets with: openssl rand -base64 32
APP_PASSPHRASE=change-me
SESSION_SECRET=

# 32-byte key (base64) used to encrypt Plaid access tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production  (Plaid's former "development" env is now limited production)
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_OPTIONAL_PRODUCTS=investments,liabilities
PLAID_COUNTRY_CODES=US

# AI
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
