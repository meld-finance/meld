# Copy to .env and fill in. Never commit .env.

# Password for the Postgres container. scripts/setup.sh generates one for new installs
# and puts it in the URLs below; an existing database keeps the password it was created with.
POSTGRES_PASSWORD=meld

# One database per Plaid environment; PLAID_ENV picks which one the API uses.
# `npm run db:migrate` migrates both.
SANDBOX_DATABASE_URL=postgres://meld:meld@127.0.0.1:5432/meld_sandbox
PRODUCTION_DATABASE_URL=postgres://meld:meld@127.0.0.1:5432/meld
# Separate database for integration tests (wiped on each run). Create it with:
#   docker compose exec db createdb -U meld meld_test
TEST_DATABASE_URL=postgres://meld:meld@127.0.0.1:5432/meld_test
API_PORT=4000
# Port for the web app when running everything in Docker (http://localhost:8080).
MELD_PORT=8080
# Comma-separated origins allowed to call the API (Expo web dev server).
CORS_ORIGINS=http://localhost:8081

# Single-user auth: the passphrase you log in with (leave empty to choose it in the app
# when MELD_CONFIG_FILE is set, as in Docker), and a secret for signing sessions.
# Generate secrets with: openssl rand -base64 32
APP_PASSPHRASE=
# Or set to 1 for no passphrase: anyone who can reach Meld can use it. Ignored when APP_PASSPHRASE is set.
APP_PASSPHRASE_OFF=
SESSION_SECRET=

# 32-byte key (base64) used to encrypt Plaid access tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
# Each environment has its own secret; PLAID_ENV picks the secret and the database.
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=
# sandbox | production
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_OPTIONAL_PRODUCTS=investments,liabilities
# true when this database is a copy of the Mac app's (`npm run dev:pull-desktop` sets it):
# unlinking a bank then removes it here only, leaving it linked for the Mac app.
PLAID_SHARED_ITEMS=
# Set to auth to let new links fetch full checking and savings numbers for the family
# packet (Plan → Estate → an account → Get from bank). Auth must be enabled for your Plaid
# account, and Plaid bills it once per connection the first time you fetch.
PLAID_ADDITIONAL_CONSENTED_PRODUCTS=
PLAID_COUNTRY_CODES=US

# AI
# Runs PDF reading, value lookups and fund make-up when both keys below are set
# (anthropic | openrouter). With only one key, that one is used.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Default model for the Ask chat
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
# Other Claude models offered in the Ask model picker
ANTHROPIC_CHAT_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# Claude effort for Ask Meld chat (low | medium | high). Empty picks medium for Opus, low otherwise.
ANTHROPIC_CHAT_EFFORT=
# Model for property value lookups (web searches)
ANTHROPIC_LOOKUP_MODEL=claude-haiku-5-5

# OpenRouter (https://openrouter.ai): one key for Gemini, GPT, Claude and other models in
# the Ask chat. Requests only go to providers that don't store or train on prompts.
OPENROUTER_API_KEY=
# Model IDs offered in the Ask model picker (see openrouter.ai/models). Empty: a few
# suggested Gemini, Claude and GPT models.
OPENROUTER_CHAT_MODELS=
# Reads insurance PDFs (must take file input natively)
OPENROUTER_MODEL=google/gemini-4-carbon
# Home and car value lookups (with the model's own web search) and fund make-up
OPENROUTER_LOOKUP_MODEL=google/gemini-4-hydrogen

# Where the Sign in with ChatGPT session is kept (encrypted). Empty: chatgpt.json next to
# MELD_CONFIG_FILE, else data/chatgpt.json.
CHATGPT_AUTH_FILE=

# Local models for the Ask chat via Ollama (https://ollama.com). Leave empty to turn off.
OLLAMA_URL=
# OLLAMA_URL=http://127.0.0.1:11434
# In Docker, reach Ollama on your computer with:
# OLLAMA_URL=http://host.docker.internal:11434
# Models to offer; empty lists every installed model that supports tool calling.
OLLAMA_CHAT_MODELS=
# Context window requested from Ollama.
OLLAMA_CONTEXT_LENGTH=16384
# Set to 1 to allow hidden thinking tokens on Ollama models that support them (slower).
OLLAMA_THINK=

# Read-only MCP server for external agents (Claude Code, Cursor, Codex). Off by default.
MCP_ENABLED=
# Dedicated bearer token for /mcp when configured via .env (overrides Settings).
MCP_TOKEN=
# Encrypted MCP settings file; empty: mcp.json next to MELD_CONFIG_FILE, else data/mcp.json.
MCP_CONFIG_FILE=
# Set to 1 to allow authenticated non-loopback requests to /mcp (e.g. over Tailscale).
MCP_ALLOW_REMOTE=

# Uploaded documents (insurance PDFs). Defaults to <repo>/data/documents, which is gitignored.
DOCUMENTS_DIR=
