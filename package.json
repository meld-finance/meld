{
  "name": "meld",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,app -c blue,magenta \"npm run dev -w @meld/api\" \"npm run web -w @meld/mobile\"",
    "dev:api": "npm run dev -w @meld/api",
    "dev:web": "npm run web -w @meld/mobile",
    "db:up": "docker compose up -d",
    "db:generate": "npm run db:generate -w @meld/api",
    "db:migrate": "npm run db:migrate -w @meld/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3"
  }
}
