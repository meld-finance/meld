{
  "name": "meld",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,app -c blue,magenta \"npm run dev -w @meld/api\" \"npm run web -w @meld/mobile\"",
    "dev:api": "npm run dev -w @meld/api",
    "dev:web": "npm run web -w @meld/mobile",
    "db:up": "docker compose up -d db",
    "docker:up": "docker compose up -d --build",
    "desktop:dev": "concurrently -n web,desktop -c magenta,green \"npm run web -w @meld/mobile\" \"npm run dev -w @meld/desktop\"",
    "desktop:build": "npm run build -w @meld/desktop",
    "desktop:dist": "npm run dist -w @meld/desktop",
    "desktop:seed-from-dev": "npm run seed-from-dev -w @meld/desktop",
    "dev:pull-desktop": "npm run pull-to-dev -w @meld/desktop",
    "db:generate": "npm run db:generate -w @meld/api",
    "db:migrate": "npm run db:migrate -w @meld/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit -w @meld/api",
    "test:db": "npm run test:db -w @meld/api",
    "check:changed": "node scripts/check-changed.mjs",
    "ui:snap": "node scripts/snap-ui.mjs",
    "site:dev": "node scripts/site-dev.mjs",
    "site:screenshots": "node scripts/make-screenshots.mjs",
    "site:check": "node scripts/make-screenshots.mjs --check",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "docs:audit": "node scripts/check-docs.mjs --working",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "node -e \"const{execFileSync:e}=require('node:child_process');const{existsSync:x}=require('node:fs');if(x('.git')&&x('.githooks')){try{e('git',['config','--local','--get','core.hooksPath'])}catch{try{e('git',['config','--local','core.hooksPath','.githooks'])}catch{}}}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  }
}
