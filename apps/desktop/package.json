{
  "name": "@meld/desktop",
  "productName": "Meld",
  "version": "0.0.1",
  "description": "Meld for macOS: your whole financial picture, on your own computer.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/build.mjs --main-only && MELD_DESKTOP_DEV=1 electron .",
    "build": "node scripts/build.mjs && electron-builder --dir",
    "dist": "node scripts/build.mjs && electron-builder",
    "seed-from-dev": "node scripts/build.mjs --main-only && MELD_DESKTOP_DEV=1 MELD_TRANSFER=seed electron .",
    "pull-to-dev": "node scripts/build.mjs --main-only && MELD_DESKTOP_DEV=1 MELD_TRANSFER=pull electron .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@meld/shared": "*",
    "@napi-rs/keyring": "2.1.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "postgres": "^3.4.9",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.6.0-beta.19",
    "@embedded-postgres/windows-x64": "18.6.0-beta.19"
  }
}
