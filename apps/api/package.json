    "@fastify/rate-limit": "^11.2.1",
    "@meld/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "plaid": "^49.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
